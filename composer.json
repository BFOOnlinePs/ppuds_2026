{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "astrotomic/laravel-translatable": "^11.16",
        "blade-ui-kit/blade-heroicons": "^2.6",
        "blade-ui-kit/blade-icons": "^1.8",
        "carlos-meneses/laravel-mpdf": "^2.1",
        "codeat3/blade-solar-icons": "^1.2",
        "darkaonline/l5-swagger": "^9.0",
        "dotswan/filament-map-picker": "^1.8",
        "filament/filament": "^3.3",
        "filament/forms": "^3.3",
        "filament/infolists": "^3.3",
        "filament/notifications": "^3.3",
        "filament/spatie-laravel-media-library-plugin": "^3.2",
        "filament/tables": "^3.3",
        "filament/widgets": "^3.3",
        "intervention/image": "^3.11",
        "jantinnerezo/livewire-alert": "^4.0",
        "khaled.alshamaa/ar-php": "^6.3",
        "laravel-notification-channels/fcm": "^5.1",
        "laravel/ai": "^0.6.8",
        "laravel/framework": "^12.0",
        "laravel/jetstream": "^5.3",
        "laravel/octane": "^2.12",
        "laravel/reverb": "^1.6",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.26",
        "laravel/telescope": "^5.11",
        "laravel/tinker": "^2.10.1",
        "laravolt/avatar": "^6.2",
        "livewire/livewire": "^3.0",
        "maatwebsite/excel": "^3.1",
        "malhal/laravel-geographical": "^1.0",
        "masmerise/livewire-toaster": "^2.8",
        "matanyadaev/laravel-eloquent-spatial": "^4.5",
        "mcamara/laravel-localization": "^2.3",
        "mhmiton/laravel-modules-livewire": "^5.1",
        "milon/barcode": "^12.0",
        "namu/wirechat": "^0.5.0",
        "nwidart/laravel-modules": "^12.0",
        "owenvoke/blade-fontawesome": "^3.2",
        "php-ffmpeg/php-ffmpeg": "^1.3",
        "robsontenorio/laravel-keycloak-guard": "^1.6",
        "saade/filament-fullcalendar": "^3.0",
        "socialiteproviders/keycloak": "^5.3",
        "spatie/laravel-activitylog": "^4.10",
        "spatie/laravel-backup": "^9.3",
        "spatie/laravel-data": "^4.17",
        "spatie/laravel-medialibrary": "^11.13",
        "spatie/laravel-permission": "^6.20",
        "spatie/laravel-query-builder": "^6.3",
        "spatie/laravel-settings": "^3.4",
        "wirechat/wirechat": "0.3"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "*",
        "barryvdh/laravel-ide-helper": "^3.5",
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        },
        "platform": {
            "php": "8.3.28"
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
